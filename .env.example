# Copy to .env (root) or server/.env and adjust as needed.
# Path of the single GET endpoint. Use "/" by default, e.g. "/random" when hosted in a subfolder.
ENTROPY_PATH=/
# Network settings for the server
HOST=127.0.0.1
PORT=5000
# Client defaults (overridden by call arguments)
SERVER_URL=http://127.0.0.1:5000
# Secret word for the payload scrambling layer. Must be identical on client
# and server (both read this file). Empty/unset = scramble layer off.
# PAYLOAD_SECRET=brass-gears-2026

# Container / Portainer stack overrides
# IMAGE_TAG=latest
# HOST_PORT=5000
# HANDLERS_FILE=./server/handlers.py
# TZ=Europe/Warsaw
# GUNICORN_CMD_ARGS=--workers=2 --threads=4 --worker-class=gthread --timeout=30 --graceful-timeout=30 --access-logfile=- --error-logfile=- --capture-output
