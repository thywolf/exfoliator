# Copy to server/.env (or use root .env) to change the endpoint path.
# Use "/" by default; e.g. "/random" when hosted in a subfolder.
ENTROPY_PATH=/
HOST=127.0.0.1
PORT=5000
# Secret word for the payload scrambling layer. Must match the client's
# PAYLOAD_SECRET exactly. Empty/unset = scramble layer off.
# PAYLOAD_SECRET=brass-gears-2026
